# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real values.

# Production / staging: point to your live API + app origin
VITE_API_URL=https://yourdomain.com/api
VITE_APP_URL=https://yourdomain.com

# Local development alternative (frontend on http://localhost:5173).
# The Vite dev proxy in vite.config.js forwards /events/api to the target host,
# so you can leave the values above, or point them at a local PHP server:
# VITE_API_URL=http://localhost:8000/api
# VITE_APP_URL=http://localhost:5173
